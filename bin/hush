#!/bin/bash
# Silence peon ping, macOS alert sounds, and music apps. Call audio stays.
# Run hush to toggle, hush on to mute, hush off to restore.

set -u

STATE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/hush"
STATE="$STATE_DIR/state"
PEON="$(command -v peon 2>/dev/null || true)"
if [ -z "$PEON" ] && [ -x "$HOME/.local/bin/peon" ]; then
  PEON="$HOME/.local/bin/peon"
fi

mkdir -p "$STATE_DIR"

alert_volume() {
  osascript -e 'alert volume of (get volume settings)'
}

set_alert_volume() {
  osascript -e "set volume alert volume $1"
}

peon_paused() {
  [ -n "$PEON" ] && "$PEON" status 2>/dev/null | grep -q 'peon-ping: paused'
}

pause_media() {
  killall afplay 2>/dev/null || true
  killall say 2>/dev/null || true
  osascript <<'APPLESCRIPT' 2>/dev/null || true
set mediaApps to {"Spotify", "Music", "TV", "QuickTime Player", "VLC", "IINA", "VOX", "Swinsian"}
tell application "System Events" to set procs to name of every process
repeat with appName in mediaApps
  if procs contains appName then
    try
      tell application appName to pause
    end try
  end if
end repeat
APPLESCRIPT
}

CURSOR_SETTINGS="$HOME/Library/Application Support/Cursor/User/settings.json"
CURSOR_CHIME_KEY='"cursor.composer.shouldChimeAfterChatFinishes"'
# Screen reader mode (editor.accessibilitySupport: on) makes every "auto" signal
# audible on each tool call. Cursor reads this key, not accessibility.signals.sounds.volume.
CURSOR_SIGNAL_VOLUME_KEY='"accessibility.signalOptions.volume"'

# Cursor's settings.json allows trailing commas, so edit the line, not the JSON.
# Only bool and number values are handled; strings could hold commas.
cursor_setting() {
  [ -f "$CURSOR_SETTINGS" ] || { echo "none"; return; }
  local line
  line="$(grep -E "^[[:space:]]*$1[[:space:]]*:" "$CURSOR_SETTINGS" | head -1)"
  if [ -z "$line" ]; then
    echo "absent"
    return
  fi
  printf '%s\n' "$line" | sed -E "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*//; s/[[:space:],]*$//"
}

set_cursor_setting() {
  [ -f "$CURSOR_SETTINGS" ] || return 0
  sed -i '' -E "s/^([[:space:]]*$1[[:space:]]*:[[:space:]]*)[^,[:space:]]*/\1$2/" "$CURSOR_SETTINGS"
}

add_cursor_setting() {
  [ -f "$CURSOR_SETTINGS" ] || return 0
  local tmp
  tmp="$(mktemp)"
  awk -v line="  $1: $2," '
    { print }
    !done && /\{/ { print line; done = 1 }
  ' "$CURSOR_SETTINGS" >"$tmp" && cat "$tmp" >"$CURSOR_SETTINGS"
  rm -f "$tmp"
}

remove_cursor_setting() {
  [ -f "$CURSOR_SETTINGS" ] || return 0
  sed -i '' -E "/^[[:space:]]*$1[[:space:]]*:[[:space:]]*$2,?[[:space:]]*$/d" "$CURSOR_SETTINGS"
}

mute_cursor_setting() {
  case "$2" in
    none | "$3") ;;
    absent) add_cursor_setting "$1" "$3" ;;
    *) set_cursor_setting "$1" "$3" ;;
  esac
}

restore_cursor_setting() {
  case "$2" in
    none | "$3") ;;
    absent) remove_cursor_setting "$1" "$3" ;;
    *) set_cursor_setting "$1" "$2" ;;
  esac
}

hush_off() {
  if [ ! -f "$STATE" ]; then
    echo "hush: sounds are already on"
    return 0
  fi

  # shellcheck disable=SC1090
  . "$STATE"
  rm -f "$STATE"

  set_alert_volume "${ALERT_VOLUME:-100}"
  if [ -n "$PEON" ] && [ "${PEON_WAS_PAUSED:-1}" = "0" ]; then
    "$PEON" resume >/dev/null
  fi
  restore_cursor_setting "$CURSOR_CHIME_KEY" "${CURSOR_CHIME:-none}" false
  restore_cursor_setting "$CURSOR_SIGNAL_VOLUME_KEY" "${CURSOR_SIGNAL_VOLUME:-none}" 0
  echo "hush: sounds restored"
}

hush_on() {
  if [ -f "$STATE" ]; then
    echo "hush: already on"
    return 0
  fi

  local volume was_paused=1
  volume="$(alert_volume)"
  if [ -n "$PEON" ]; then
    if peon_paused; then
      was_paused=1
    else
      was_paused=0
      "$PEON" pause >/dev/null
    fi
  fi

  local chime signal_volume
  chime="$(cursor_setting "$CURSOR_CHIME_KEY")"
  signal_volume="$(cursor_setting "$CURSOR_SIGNAL_VOLUME_KEY")"

  printf 'ALERT_VOLUME=%s\nPEON_WAS_PAUSED=%s\nCURSOR_CHIME=%s\nCURSOR_SIGNAL_VOLUME=%s\n' \
    "$volume" "$was_paused" "$chime" "$signal_volume" >"$STATE"
  set_alert_volume 0
  mute_cursor_setting "$CURSOR_CHIME_KEY" "$chime" false
  mute_cursor_setting "$CURSOR_SIGNAL_VOLUME_KEY" "$signal_volume" 0
  pause_media

  local muted="alerts, music"
  [ -n "$PEON" ] && muted="peon, $muted"
  [ "$chime" != "none" ] && muted="$muted, Cursor"
  echo "hush: on. Muted: $muted. Call audio stays."
}

hush_toggle() {
  if [ -f "$STATE" ]; then
    hush_off
  else
    hush_on
  fi
}

case "${1:-}" in
  status)
    if [ -f "$STATE" ]; then
      echo "hush: on"
    else
      echo "hush: off"
    fi
    ;;
  on)
    hush_on
    ;;
  off)
    hush_off
    ;;
  *)
    hush_toggle
    ;;
esac
