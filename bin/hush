#!/bin/bash
# Silence peon ping, macOS alert sounds, Cursor chimes, and music apps.
# Call audio stays. Run hush to toggle, hush on to mute, hush off to restore.

set -u

STATE_DIR="${XDG_CACHE_HOME:-$HOME/Library/Caches}/hush"
STATE="$STATE_DIR/state"
PEON="$(command -v peon 2>/dev/null || true)"
if [ -z "$PEON" ] && [ -x "$HOME/.local/bin/peon" ]; then
  PEON="$HOME/.local/bin/peon"
fi

mkdir -p "$STATE_DIR"

alert_volume() {
  osascript -e 'alert volume of (get volume settings)'
}

set_alert_volume() {
  osascript -e "set volume alert volume $1"
}

peon_paused() {
  [ -n "$PEON" ] && "$PEON" status 2>/dev/null | grep -q 'peon-ping: paused'
}

cursor_pref() {
  python3 - "$@" <<'PY'
import pathlib, re, sys

path = pathlib.Path.home() / "Library/Application Support/Cursor/User/settings.json"
key = "cursor.composer.shouldChimeAfterChatFinishes"
pat = re.compile(r'("' + re.escape(key) + r'"\s*:\s*)(true|false)')

def read():
    return path.read_text() if path.exists() else ""

cmd = sys.argv[1]
if cmd == "get":
    text = read()
    m = pat.search(text)
    print(m.group(2) if m else "true")
elif cmd == "set":
    value = sys.argv[2]
    if not path.exists():
        sys.exit(0)
    text = read()
    m = pat.search(text)
    if m:
        text = pat.sub(r"\1" + value, text, count=1)
    else:
        before, brace, after = text.rpartition("}")
        body = before.rstrip()
        if body and not body.endswith("{") and not body.endswith(","):
            body += ","
        text = body + "\n  \"" + key + "\": " + value + ",\n" + brace + after
    path.write_text(text)
PY
}

pause_media() {
  killall afplay peon-play say 2>/dev/null || true
  for pidfile in \
    "$HOME/.claude/hooks/peon-ping/.sound.pid" \
    "$HOME/.openpeon/.sound.pid"; do
    if [ -f "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
    fi
  done
  osascript <<'APPLESCRIPT' 2>/dev/null || true
set mediaApps to {"Spotify", "Music", "TV", "QuickTime Player", "VLC", "IINA", "VOX", "Swinsian"}
tell application "System Events" to set procs to name of every process
repeat with appName in mediaApps
  if procs contains appName then
    try
      tell application appName to pause
    end try
  end if
end repeat
APPLESCRIPT
}

hush_off() {
  if [ ! -f "$STATE" ]; then
    echo "hush: sounds are already on"
    return 0
  fi

  # shellcheck disable=SC1090
  . "$STATE"
  rm -f "$STATE"

  set_alert_volume "${ALERT_VOLUME:-100}"
  if [ -n "$PEON" ] && [ "${PEON_WAS_PAUSED:-1}" = "0" ]; then
    "$PEON" resume >/dev/null
  fi
  if [ -n "${CURSOR_CHIME:-}" ]; then
    cursor_pref set "$CURSOR_CHIME"
  fi
  echo "hush: sounds restored"
}

hush_on() {
  if [ -f "$STATE" ]; then
    echo "hush: already on"
    return 0
  fi

  local volume was_paused=1 chime
  volume="$(alert_volume)"
  chime="$(cursor_pref get)"
  if [ -n "$PEON" ]; then
    if peon_paused; then
      was_paused=1
    else
      was_paused=0
      "$PEON" pause >/dev/null
    fi
  fi

  printf 'ALERT_VOLUME=%s\nPEON_WAS_PAUSED=%s\nCURSOR_CHIME=%s\n' \
    "$volume" "$was_paused" "$chime" >"$STATE"
  set_alert_volume 0
  cursor_pref set false
  pause_media
  echo "hush: paused peon, Cursor chimes, alerts, and music. Call audio stays."
}

hush_toggle() {
  if [ -f "$STATE" ]; then
    hush_off
  else
    hush_on
  fi
}

case "${1:-}" in
  status)
    if [ -f "$STATE" ]; then
      echo "hush: on"
    else
      echo "hush: off"
    fi
    ;;
  on)
    hush_on
    ;;
  off)
    hush_off
    ;;
  *)
    hush_toggle
    ;;
esac
